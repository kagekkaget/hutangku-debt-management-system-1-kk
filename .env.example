# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Session signing secret (change in production)
AUTH_SECRET=ganti-dengan-string-acak-yang-panjang

# WhatsApp API Gateway (opsional — jika kosong, pengingat berjalan dalam mode simulasi)
# Provider yang didukung: fonnte | wablas | generic
WA_GATEWAY_PROVIDER=fonnte
WA_GATEWAY_URL=https://api.fonnte.com/send
WA_GATEWAY_TOKEN=

# Melindungi endpoint /api/cron/reminders (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
